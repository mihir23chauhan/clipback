{
  "name": "clipback",
  "version": "0.1.0",
  "private": true,
  "description": "Clip a YouTube segment into a grounded written note without leaving youtube.com",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "e2e": "playwright test",
    "evals": "node scripts/evals.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/chrome": "^0.0.300",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "@eslint/js": "^9.18.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
