{
  "manifest_version": 3,
  "name": "clipback",
  "version": "0.1.0",
  "description": "Clip a YouTube segment into a grounded written note without leaving youtube.com",
  "permissions": ["storage", "activeTab", "downloads"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": { "service_worker": "worker.js" },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://*.youtube.com/watch*"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "options_page": "options.html",
  "web_accessible_resources": [
    { "resources": ["tokens.css"], "matches": ["https://*.youtube.com/*"] }
  ]
}
